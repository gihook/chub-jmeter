            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def ttfb = prev.getLatency()
def totalTime = prev.getTime()
def transferTime = totalTime - ttfb

vars.put(&quot;ttfb&quot;, ttfb.toString())
vars.put(&quot;transferTime&quot;, transferTime.toString())

log.info(&quot;TTFB: &quot; + ttfb + &quot;ms | Transfer: &quot; + transferTime + &quot;ms | Total: &quot; + totalTime + &quot;ms&quot;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
