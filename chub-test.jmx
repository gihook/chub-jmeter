        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Apply Shared Cookies" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import org.apache.jmeter.protocol.http.control.Cookie

def cm = sampler.getCookieManager()
if (cm != null &amp;&amp; cm.getCookieCount() == 0) {
    def countStr = props.get(&quot;SHARED_COOKIE_COUNT&quot;)
    if (countStr != null) {
        int count = Integer.parseInt(countStr)
        for (int i = 0; i &lt; count; i++) {
            def name = props.get(&quot;SHARED_COOKIE_NAME_&quot; + i)
            def value = props.get(&quot;SHARED_COOKIE_VALUE_&quot; + i)
            def domain = props.get(&quot;SHARED_COOKIE_DOMAIN_&quot; + i)
            def path = props.get(&quot;SHARED_COOKIE_PATH_&quot; + i) ?: &quot;/&quot;
            def cookie = new Cookie(name, value, domain, path, false, System.currentTimeMillis() + 86400000L)
            cm.add(cookie)
        }
    }
}</stringProp>
        </JSR223PreProcessor>
