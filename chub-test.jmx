          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save Cookies to Properties" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def cm = sampler.getCookieManager()
if (cm != null) {
    props.put(&quot;SHARED_COOKIE_COUNT&quot;, cm.getCookieCount().toString())
    for (int i = 0; i &lt; cm.getCookieCount(); i++) {
        def cookie = cm.get(i)
        props.put(&quot;SHARED_COOKIE_NAME_&quot; + i, cookie.getName())
        props.put(&quot;SHARED_COOKIE_VALUE_&quot; + i, cookie.getValue())
        props.put(&quot;SHARED_COOKIE_DOMAIN_&quot; + i, cookie.getDomain())
        props.put(&quot;SHARED_COOKIE_PATH_&quot; + i, cookie.getPath())
    }
    log.info(&quot;[setUp] Saved &quot; + cm.getCookieCount() + &quot; cookies to props for sharing.&quot;)
}
if (props.get(&quot;SHARED_COOKIE_COUNT&quot;) == null || Integer.parseInt(props.get(&quot;SHARED_COOKIE_COUNT&quot;)) == 0) {
    log.error(&quot;[setUp] CRITICAL: No cookies captured during login!&quot;)
}</stringProp>
          </JSR223PostProcessor>
